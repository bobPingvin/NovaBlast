# NovaBlast Environment Variables

# Container URL (automatically injected in AI Studio / Cloud Run)
APP_URL=http://localhost:3000

# Gemini API Key (automatically injected in AI Studio)
GEMINI_API_KEY=

# Optional: Steam Web API Key (https://steamcommunity.com/dev/apikey)
# Used to fetch player nickname and full-resolution avatar for all profile privacy levels.
# Note: Steam OpenID 2.0 login works even without this key (public profiles fall back to Steam XML).
STEAM_API_KEY=

# Optional (Recommended for Firestore Cloud Save with Steam):
# Paste the full JSON content of your Firebase Service Account key
# (Firebase Console -> Project Settings -> Service accounts -> Generate new private key)
# This enables the server to mint official Firebase Custom Tokens (steam_<steamId>) for Firestore rules.
FIREBASE_SERVICE_ACCOUNT=

# Alternative individual Firebase Admin variables (if not using FIREBASE_SERVICE_ACCOUNT JSON):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: Custom HMAC secret for signing Steam session cookies
STEAM_SESSION_SECRET=

# Optional: GitHub OAuth App Credentials (https://github.com/settings/developers)
# Required for backend OAuth 2.0 flow if GitHub provider is not enabled in Firebase Console.
# Callback URL:
# https://novablast-livid.vercel.app/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: X (Twitter) OAuth 2.0 Credentials (https://developer.x.com)
# X_CLIENT_SECRET is required for Confidential clients (Web App) and optional for Public clients (PKCE).
# Callback URL:
# https://novablast-livid.vercel.app/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional (Vercel Reverse Proxy for Firebase Google Auth):
# Set to your domain without https:// (e.g. novablast-livid.vercel.app)
# Also add https://novablast-livid.vercel.app/__/auth/handler to Google Cloud Console
# -> APIs & Services -> Credentials -> Web client -> Authorized redirect URIs
VITE_FIREBASE_AUTH_DOMAIN=

# Optional (Web Landing / Vercel): Direct download URL for the Windows Electron installer (.exe)
# Example: https://github.com/bobPingvin/NovaBlast/releases/latest/download/NovaBlast-Setup.exe
# Leave empty to fall back to /downloads/NovaBlast-Setup.exe or display the setup instructions dialog.
VITE_WINDOWS_DOWNLOAD_URL=

