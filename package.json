{
  "name": "novablast",
  "private": true,
  "version": "1.0.0",
  "description": "NovaBlast - Multiplayer Collaborative Canvas",
  "author": "NovaBlast Team <support@novablast.xyz>",
  "homepage": "https://novablast.xyz",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "dev:electron": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "build:electron": "npm run build && electron-builder",
    "build:linux": "npm run build && electron-builder --linux AppImage",
    "build:linux-deb": "npm run build && electron-builder --linux deb",
    "build:linux-rpm": "npm run build && unset npm_config_prefix && electron-builder --linux rpm",
    "build:linux-zip": "npm run build && electron-builder --linux zip",
    "build:linux-dir": "npm run build && electron-builder --linux dir"
  },
  "license": "MIT",
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "gifenc": "^1.0.3",
    "jszip": "^3.10.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@google/genai": "^1.40.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^34.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "firebase": "^12.11.0",
    "lucide-react": "^0.563.0",
    "motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.novablast.app",
    "productName": "NovaBlast",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "package.json",
      "firebase-applet-config.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": ["AppImage", "rpm"],
      "maintainer": "NovaBlast Team <support@novablast.xyz>",
      "icon": "build/icon.png",
      "category": "Graphics"
    }
  }
}
