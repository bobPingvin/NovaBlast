rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: projects
    // Document ID: {projectId}
    // Fields:
    //   - id: string (optional) - The unique identifier for the project.
    //   - name: string (required, min 1, max 100) - The name of the project.
    //   - grid: string (required) - The serialized grid data (JSON string).
    //   - width: int (required) - The width of the canvas.
    //   - height: int (required) - The height of the canvas.
    //   - userId: string (required) - The ID of the user who owns the project.
    //   - updatedAt: timestamp (required) - The timestamp when the project was last updated.
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "zuravlevm379@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidProject(data) {
      return hasRequiredFields(['name', 'grid', 'width', 'height', 'userId', 'updatedAt']) &&
             hasOnlyAllowedFields(['id', 'name', 'grid', 'width', 'height', 'userId', 'updatedAt', 'ownerName', 'ownerEmail', 'previewImage', 'projectType', 'fps', 'frames', 'customColors']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.grid is string &&
             data.width is int && data.width > 0 &&
             data.height is int && data.height > 0 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.updatedAt is timestamp &&
             (!('ownerName' in data) || data.ownerName is string) &&
             (!('ownerEmail' in data) || data.ownerEmail is string) &&
             (!('previewImage' in data) || data.previewImage is string) &&
             (!('projectType' in data) || (data.projectType is string && (data.projectType == 'static' || data.projectType == 'animated'))) &&
             (!('fps' in data) || (data.fps is int && data.fps > 0 && data.fps <= 60)) &&
             (!('frames' in data) || (data.frames is list && data.frames.size() <= 100)) &&
             (!('customColors' in data) || (data.customColors is list && data.customColors.size() <= 100));
    }

    function isValidProjectUpdate(data) {
      return hasOnlyAllowedFields(['id', 'name', 'grid', 'width', 'height', 'userId', 'updatedAt', 'ownerName', 'ownerEmail', 'previewImage', 'projectType', 'fps', 'frames', 'customColors']) &&
             (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 100)) &&
             (!('grid' in data) || data.grid is string) &&
             (!('width' in data) || (data.width is int && data.width > 0)) &&
             (!('height' in data) || (data.height is int && data.height > 0)) &&
             (!('userId' in data) || (data.userId is string && data.userId == request.auth.uid)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp) &&
             (!('ownerName' in data) || data.ownerName is string) &&
             (!('ownerEmail' in data) || data.ownerEmail is string) &&
             (!('previewImage' in data) || data.previewImage is string) &&
             (!('projectType' in data) || (data.projectType is string && (data.projectType == 'static' || data.projectType == 'animated'))) &&
             (!('fps' in data) || (data.fps is int && data.fps > 0 && data.fps <= 60)) &&
             (!('frames' in data) || (data.frames is list && data.frames.size() <= 100)) &&
             (!('customColors' in data) || (data.customColors is list && data.customColors.size() <= 100));
    }

    function isValidHotkey(hotkey) {
      return hotkey is map &&
             hotkey.key is string && hotkey.key.size() <= 20 &&
             (!('ctrl' in hotkey) || hotkey.ctrl is bool) &&
             (!('shift' in hotkey) || hotkey.shift is bool) &&
             (!('alt' in hotkey) || hotkey.alt is bool) &&
             hotkey.label is string && hotkey.label.size() <= 50;
    }

    function isValidHotkeyConfig(data) {
      return data is map &&
             isValidHotkey(data.undo) &&
             isValidHotkey(data.redo) &&
             isValidHotkey(data.pen) &&
             isValidHotkey(data.eraser) &&
             isValidHotkey(data.fill) &&
             isValidHotkey(data.picker) &&
             isValidHotkey(data.gradient) &&
             isValidHotkey(data.toggleGrid) &&
             isValidHotkey(data.brushResize) &&
             (!('playAnimation' in data) || isValidHotkey(data.playAnimation)) &&
             (!('line' in data) || isValidHotkey(data.line)) &&
             (!('ruler' in data) || isValidHotkey(data.ruler)) &&
             (!('mirror' in data) || isValidHotkey(data.mirror));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /projects/{projectId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && isValidProject(request.resource.data);
      allow update: if isAuthenticated() && isValidProjectUpdate(request.resource.data) && (isOwner(resource.data.userId) || isAdmin());
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }

    match /community_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'viewsCount', 'updatedAt']));
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.uid == userId;
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAdmin();

      match /settings/hotkeys {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) || isAdmin()) && isValidHotkeyConfig(request.resource.data);
      }
    }
  }
}

