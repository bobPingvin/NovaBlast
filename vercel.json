{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/((?!router).*)",
      "destination": "/api/router?__route=/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/router?__route=/auth/$1"
    },
    {
      "source": "/__/auth/(.*)",
      "destination": "https://gen-lang-client-0487154255.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/__/firebase/(.*)",
      "destination": "https://gen-lang-client-0487154255.firebaseapp.com/__/firebase/$1"
    },
    {
      "source": "/((?!api/|auth/|__/|assets/|downloads/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
